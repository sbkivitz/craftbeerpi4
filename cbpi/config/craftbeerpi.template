[Unit]
Description=Craftbeer Pi
After=mosquitto.service influxdb.service

[Service]
WorkingDirectory=/home/{{ user }}
ExecStartPre=/bin/sleep 5
ExecStart={{ path }} start
# SIGTERM: the shutdown it runs switches every actor off. SIGKILL left the
# outputs as they were - an element or pump energized, with no process
# behind it. A stop that hangs is still killed after TimeoutStopSec.
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
